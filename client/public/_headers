/*
  # Security Headers (production)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # We embed Google Maps on /contact; COEP: require-corp breaks many third-party iframes.
  Cross-Origin-Embedder-Policy: unsafe-none

  # Content Security Policy
  # - Allows Google Fonts stylesheets
  # - Allows GA4 (googletagmanager)
  # - Allows Microsoft Clarity
  # - Allows Google Maps embed on the Contact page
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; frame-src 'self' https://www.google.com https://www.google.com/maps https://www.google.com/maps/embed https://maps.google.com https://www.openstreetmap.org; script-src 'self' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data: https: https://www.clarity.ms https://c.clarity.ms https://*.clarity.ms; connect-src 'self' https: https://www.clarity.ms https://c.clarity.ms https://*.clarity.ms; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; worker-src 'self'; manifest-src 'self'

  X-Powered-By: Etlaq Tech

  # HTML / SPA routes should be revalidated
  Cache-Control: public, max-age=0, must-revalidate

# Cache static assets (fingerprinted by Vite)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# Cache images aggressively
/gallery/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/article-images/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
/og-share.*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin

# Ensure the Service Worker and manifest are always updated promptly
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
