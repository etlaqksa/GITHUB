# --- Language-prefixed SPA routing (avoid trailing-slash redirect loops) ---
# We serve the SPA entry for both /ar and /ar/* (same for /en).
# This avoids infinite redirects if the Netlify site has a trailing-slash setting.
/        /ar           301!

# --- Legacy case-studies route is merged into /projects ---
# Must be BEFORE the /ar/* and /en/* SPA rewrites.
/ar/case-studies   /ar/projects   301!
/en/case-studies   /en/projects   301!

/ar     /index.html   200
/ar/*   /index.html   200
/en     /index.html   200
/en/*   /index.html   200

# --- Exclude static assets from language redirects ---
/assets/*          /assets/:splat          200
/images/*          /images/:splat          200
/gallery/*         /gallery/:splat         200
/article-images/*  /article-images/:splat  200
/favicon.png       /favicon.png           200
/logo.png          /logo.png              200
/manifest.json     /manifest.json         200
/robots.txt        /robots.txt            200
/sitemap.xml       /sitemap.xml           200
/googleb9eafcb71ddde876.html /googleb9eafcb71ddde876.html 200
/company-profile.pdf  /company-profile.pdf 200
/og-image.jpg      /og-image.jpg          200
/og-image.webp     /og-image.webp         200
/__forms.html      /__forms.html          200

# --- Exclude API paths (future Netlify functions / server endpoints) ---
/api/*   /api/:splat   200

# --- Legacy (non-prefixed) routes support ---
# Keep old links working by rewriting EVERYTHING to the SPA entry.
# The app will immediately canonicalize the URL to /ar/* (or /en/*)
# using history.replaceState without reload.
/*      /index.html   200
