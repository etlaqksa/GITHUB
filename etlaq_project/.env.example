### EtlaqKSA – Example environment
# IMPORTANT (SEO): used by sitemap generator and canonical URLs
SITE_URL=https://etlaqksa.com
VITE_SITE_URL=https://etlaqksa.com

# Optional: GA4 (leave empty to disable)
VITE_GA_MEASUREMENT_ID=

# Optional: Umami analytics (leave empty to disable)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional server/OAuth (NOT required for the marketing website)
OAUTH_SERVER_URL=

# Infrastructure (server-only; not needed for Netlify static deploy)
PORT=3000

# Home hero background style: light (default) | gradient | blobs | grid
VITE_HERO_VARIANT=

# Lightweight deterrent (NOT real security): blocks some shortcuts + shows overlay if DevTools is open
VITE_ANTI_INSPECT=false
