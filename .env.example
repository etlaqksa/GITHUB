# ═══════════════════════════════════════════════
#  ETLAQ KSA - Environment Variables Reference
#  Copy this file to .env and fill in values
# ═══════════════════════════════════════════════

# Site URL (used in sitemap, SEO, and OG tags)
VITE_SITE_URL=https://etlaqksa.com

# Hero variant: light | gradient | blobs | grid
VITE_HERO_VARIANT=light

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID
VITE_CLARITY_ID=xxxxxxxxxx

# NOTE: Anti-inspect is permanently disabled (was harmful to UX).
# Do NOT set VITE_ANTI_INSPECT=true — it has no effect.

# Internal tools (for development only, never in production)
# VITE_INTERNAL_TOOLS=true
